{
  "name": "landing-page-guilherme",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page de psicologia clínica de Guilherme dos Santos Teixeira",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tailwindcss --postcss postcss.build.config.js -i styles.source.css -o styles.css",
    "serve": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:js": "node --check script.js && node --check contact.js && node --check site-config.js",
    "check:css": "node scripts/check-css.mjs",
    "check:release": "node scripts/check-release.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test": "npm run check:js && npm run format:check && npm run check:css && npm run test:unit"
  },
  "browserslist": [
    "defaults",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "devDependencies": {
    "autoprefixer": "10.6.2",
    "cssnano": "7.1.9",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17"
  }
}
